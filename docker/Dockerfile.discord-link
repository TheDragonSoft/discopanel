FROM golang:alpine AS builder

WORKDIR /build

# Copy go mod files first for caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY cmd/discord-link/ ./cmd/discord-link/

# Build the binary
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /discord-link ./cmd/discord-link

FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /discord-link /usr/local/bin/discord-link

ENTRYPOINT ["/usr/local/bin/discord-link"]
