# ==============================================================================
# DiscoPanel Local Development Environment Configuration
# ==============================================================================
# Copy this file to .env or set these environment variables in your terminal / IDE.
# All settings override defaults in internal/config/config.go and config.example.yaml.
# ==============================================================================

# ── Server Configuration ──────────────────────────────────────────────────────
DISCOPANEL_SERVER_PORT=8080
DISCOPANEL_SERVER_HOST=0.0.0.0
DISCOPANEL_SERVER_READ_TIMEOUT=15
DISCOPANEL_SERVER_WRITE_TIMEOUT=15
DISCOPANEL_SERVER_IDLE_TIMEOUT=60
DISCOPANEL_SERVER_USER_AGENT="DiscoPanel/1.0-dev (github.com/nickheyer/discopanel)"

# ── Database Configuration ───────────────────────────────────────────────────
# SQLite database path (WAL mode is enabled automatically)
DISCOPANEL_DATABASE_PATH=./data/discopanel.db
DISCOPANEL_DATABASE_MAX_CONNECTIONS=25
DISCOPANEL_DATABASE_MAX_IDLE_CONNS=5
DISCOPANEL_DATABASE_CONN_MAX_LIFETIME=300
DISCOPANEL_DATABASE_AUTO_MIGRATE=true

# ── Docker Engine Configuration ──────────────────────────────────────────────
# Linux / macOS socket:
DISCOPANEL_DOCKER_HOST=unix:///var/run/docker.sock
# Windows Docker Desktop (Named Pipe alternative if unix socket is not linked):
# DISCOPANEL_DOCKER_HOST=npipe:////./pipe/docker_engine
# Windows Docker TCP alternative:
# DISCOPANEL_DOCKER_HOST=tcp://127.0.0.1:2375

DISCOPANEL_DOCKER_NETWORK_NAME=discopanel-network
DISCOPANEL_DOCKER_SYNC_INTERVAL=5
DISCOPANEL_DOCKER_REGISTRY_URL=""
DISCOPANEL_DOCKER_DNS=""

# ── Storage Directories ───────────────────────────────────────────────────────
DISCOPANEL_STORAGE_DATA_DIR=./data
DISCOPANEL_STORAGE_BACKUP_DIR=./data/backups
DISCOPANEL_STORAGE_TEMP_DIR=./data/temp
DISCOPANEL_STORAGE_MAX_UPLOAD_SIZE=524288000  # 500MB in bytes

# ── Authentication & Security ────────────────────────────────────────────────
DISCOPANEL_AUTH_SESSION_TIMEOUT=86400         # 24 hours in seconds
DISCOPANEL_AUTH_ANONYMOUS_ACCESS=false
DISCOPANEL_AUTH_JWT_SECRET=dev-jwt-secret-key-change-in-production-32bytes
DISCOPANEL_AUTH_LOCAL_ENABLED=true
DISCOPANEL_AUTH_LOCAL_ALLOW_REGISTRATION=true  # Set true for easy local dev signup

# ── OIDC Authentication (Optional, e.g. Keycloak / Authelia) ──────────────────
DISCOPANEL_AUTH_OIDC_ENABLED=false
DISCOPANEL_AUTH_OIDC_ISSUER_URI=http://localhost:8180/realms/discopanel
DISCOPANEL_AUTH_OIDC_CLIENT_ID=discopanel
DISCOPANEL_AUTH_OIDC_CLIENT_SECRET=discopanel-dev-secret
DISCOPANEL_AUTH_OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
DISCOPANEL_AUTH_OIDC_ROLE_CLAIM=groups
DISCOPANEL_AUTH_OIDC_SKIP_TLS_VERIFY=true

# ── Smart Minecraft Proxy Engine ─────────────────────────────────────────────
DISCOPANEL_PROXY_ENABLED=true
DISCOPANEL_PROXY_BASE_URL=mc.local
DISCOPANEL_PROXY_LISTEN_PORT=25565
DISCOPANEL_PROXY_PORT_RANGE_MIN=25565
DISCOPANEL_PROXY_PORT_RANGE_MAX=25665

# ── Module Sidecar Subsystem ─────────────────────────────────────────────────
DISCOPANEL_MODULE_ENABLED=true
DISCOPANEL_MODULE_PORT_RANGE_MIN=8100
DISCOPANEL_MODULE_PORT_RANGE_MAX=8199

# ── Logging Configuration ────────────────────────────────────────────────────
DISCOPANEL_LOGGING_ENABLED=true
DISCOPANEL_LOGGING_FILE_PATH=./data/logs/discopanel.log
DISCOPANEL_LOGGING_MAX_SIZE=10
DISCOPANEL_LOGGING_MAX_BACKUPS=5
DISCOPANEL_LOGGING_MAX_AGE=30
DISCOPANEL_LOGGING_COMPRESS=true

# ── Upload Session Configuration ─────────────────────────────────────────────
DISCOPANEL_UPLOAD_SESSION_TTL=240
DISCOPANEL_UPLOAD_DEFAULT_CHUNK_SIZE=5242880   # 5MB
DISCOPANEL_UPLOAD_MAX_CHUNK_SIZE=10485760       # 10MB
