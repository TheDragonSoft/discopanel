{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug DiscoPanel (Go Backend)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/discopanel",
      "env": {
        "DISCOPANEL_SERVER_PORT": "8080",
        "DISCOPANEL_SERVER_HOST": "0.0.0.0",
        "DISCOPANEL_DATABASE_PATH": "${workspaceFolder}/data/discopanel.db",
        "DISCOPANEL_STORAGE_DATA_DIR": "${workspaceFolder}/data",
        "DISCOPANEL_STORAGE_BACKUP_DIR": "${workspaceFolder}/data/backups",
        "DISCOPANEL_STORAGE_TEMP_DIR": "${workspaceFolder}/data/temp",
        "DISCOPANEL_LOGGING_FILE_PATH": "${workspaceFolder}/data/logs/discopanel.log",
        "DISCOPANEL_AUTH_LOCAL_ENABLED": "true",
        "DISCOPANEL_AUTH_LOCAL_ALLOW_REGISTRATION": "true"
      },
      "args": [],
      "showLog": true
    },
    {
      "name": "Debug DiscoPanel with config.yaml (Go)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/discopanel",
      "args": ["-config", "${workspaceFolder}/config.yaml"],
      "showLog": true
    },
    {
      "name": "Debug Current Go Test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "showLog": true
    },
    {
      "name": "Debug All Go Tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/...",
      "args": ["-v"],
      "showLog": true
    },
    {
      "name": "Attach to Docker / Delve (Port 2345)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2345,
      "host": "127.0.0.1"
    },
    {
      "name": "Debug Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web/discopanel/src",
      "sourceMaps": true,
      "smartStep": true
    },
    {
      "name": "Debug Frontend (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web/discopanel/src",
      "sourceMaps": true,
      "smartStep": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Chrome Frontend",
      "configurations": [
        "Debug DiscoPanel (Go Backend)",
        "Debug Frontend (Chrome)"
      ],
      "stopAll": true
    }
  ]
}
